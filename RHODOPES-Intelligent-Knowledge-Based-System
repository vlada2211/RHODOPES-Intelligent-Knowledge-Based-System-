% =========================================================
% INPUT VALIDATION 
% =========================================================

read_number(Number) :-
    read_line_to_string(user_input, Str),
    catch(number_string(Number, Str), _, Number = -1).

format_label(Atom, Text) :-
    atomic_list_concat(Parts, '_', Atom),
    atomic_list_concat(Parts, ' ', Temp),
    atom_chars(Temp, [H|T]),
    upcase_atom(H, H2),
    atom_chars(Text, [H2|T]).

% =========================================================
% DISPLAY HELPERS
% =========================================================
print_text(X) :-
    format_label(X, T),
    writeln(T).

print_kv(Label, Value) :-
    format_label(Label, L),
    format_label(Value, V),
    format('~w: ~w~n', [L, V]).
% =========================================================
% INPUT NORMALIZATION
% =========================================================
normalize_atom(Input, Atom) :-
    string_lower(Input, Lower),
    normalize_space(string(Trimmed), Lower),
    split_string(Trimmed, " _", " _", Words),
    atomic_list_concat(Words, '_', Atom).
