% =========================================================
% Word match in legend name
% =========================================================

legend_contains(Word, L) :-
    legend(L),
    normalize_text(L, Low),
    normalize_text(Word, W),
    split_string(Low, "_", "_", Parts),
    member(P, Parts),
    sub_string(P, _, _, _, W).
% =========================================================
% OPTIONS
% =========================================================

cult_option(1) :-
    print_text('--- Legends ---'),
    forall(legend(L),
        print_text(L)
    ),
    nl, !.

cult_option(2) :-
    print_text('--- Ancient Mentions ---'),
    forall(fact(S,T),
        ( print_kv('Source', S),
          print_kv('Fact', T),
          nl
        )
    ),
    nl, !.

cult_option(3) :-
    print_text('--- Historical Sites ---'),
    forall(historical_place(P,D),
        ( print_kv('Place', P),
          print_kv('Description', D),
          nl
        )
    ),
    nl, !.

cult_option(4) :-
    print_text('--- Traditions ---'),
    forall(tradition(T),
        print_text(T)
    ),
    nl, !.

cult_option(5) :-
    count_legends(N),
    print_kv('Total legends', N),
    nl, !.

cult_option(6) :-
    write('Enter word: '),
    read_line_to_string(user_input, Input),
    normalize_text(Input, W), nl,

    findall(L,
        ( legend(L),
          normalize_text(L, Low),
          sub_string(Low, _, _, _, W)
        ),
        List),

    ( List \= []
    -> forall(member(X,List),
        print_text(X)
    )
    ; print_text('No matches found.')
    ),
    nl, !.

cult_option(7) :-
    write('Enter place: '),
    read_line_to_string(user_input, Input),
    normalize_text(Input, P), nl,

    findall(L,
        ( legend_place(Key, P),
          legend(L),
          normalize_text(L, Low),
          sub_string(Low, _, _, _, Key)
        ),
        List),

    ( List \= []
    -> forall(member(X,List),
        print_text(X)
    )
    ; print_text('No legends found.')
    ),
    nl, !.

cult_option(8) :-
    print_text('--- Culture Quiz ---'),

    print_text('1. Who is associated with the Rhodopes?'),
    read_line_to_string(user_input, A1),
    normalize_text(A1, R1),
    ( sub_string(R1, _, _, _, "orpheus")
    -> print_text('Correct!')
    ;  print_text('Wrong: Orpheus')
    ),

    print_text('2. Which place is an ancient rock city?'),
    read_line_to_string(user_input, A2),
    normalize_text(A2, R2),
    ( sub_string(R2, _, _, _, "perperikon")
    -> print_text('Correct!')
    ;  print_text('Wrong: Perperikon')
    ),
    nl, !.

cult_option(9) :-
    findall(L, legend(L), Ls),
    findall(P, historical_place(P,_), Ps),
    findall(T, tradition(T), Ts),

    length(Ls, LN),
    length(Ps, PN),
    length(Ts, TN),

    print_text('--- Statistics ---'),
    print_kv('Legends', LN),
    print_kv('Historical places', PN),
    print_kv('Traditions', TN),
    nl, !.

cult_option(10) :-
    print_text('--- Cultural Explanation ---'),
    forall(culture_explanation(Fact),
        print_text(Fact)
    ),
    nl, !.

cult_option(11) :-
    print_text('--- Culture Recommendations ---'),
    nl,

    write('Enter interest (mythology/tradition/history/spiritual): '),
    read_line_to_string(user_input, Input),
    normalize_text(Input, Interest), nl,

    (
        Interest = mythology ->
            print_text('You are interested in mythology, so you might enjoy:'), nl;
        Interest = tradition ->
            print_text('You are interested in traditions, so you might enjoy:'), nl;
        Interest = history ->
            print_text('You are interested in history, so you might enjoy:'), nl;
        Interest = spiritual ->
            print_text('You are interested in spiritual heritage, so you might enjoy:'), nl;
        print_text('General recommendations:'), nl
    ),

    findall(R,
        culture_recommendation(Interest, R),
        List
    ),

    ( List \= []
    ->
        forall(member(X, List),
            print_text(X)
        );
   
        print_text('No recommendations found.')
    ),

    nl,
    print_text('--- End ---'),
    nl, !.

cult_option(0) :-
    print_text('Back...'), nl, !.

cult_option(_) :-
    print_text('Invalid selection!'), nl, !.
