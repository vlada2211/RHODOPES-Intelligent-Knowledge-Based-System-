% =========================================================
% LOGIC
% =========================================================

animal(X) :- mammal(X).
animal(X) :- bird(X).
animal(X) :- reptile(X).
animal(X) :- amphibian(X).

animal_type(X, mammal) :-
    mammal(X).
animal_type(X, bird) :-
    bird(X).
animal_type(X, reptile) :-
    reptile(X).
animal_type(X, amphibian) :-
    amphibian(X).

animal_exists(X) :-
    animal(X).

is_predator(X) :-
    predator(X).
is_herbivore(X) :-
    herbivore(X).

diet(X, predator) :-
    predator(X).
diet(X, herbivore) :-
    herbivore(X).
diet(X, omnivore) :-
    omnivore(X).

search_animals(Query, List) :-
    findall(
        A,
        (
            animal(A),
            sub_atom(A, _, _, _, Query)
        ),
        List
    ).

suggest_animal(Type, yes, Animal) :-
    animal_type(Animal, Type),
    protected_species(Animal).

suggest_animal(Type, no, Animal) :-
    animal_type(Animal, Type).

count_animals(Type, Count) :-
    findall(
        A,
        animal_type(A, Type),
        L
    ),
    length(L, Count).


compare_animals(A1, A2) :-

    % Тип
    ( animal_type(A1, T), animal_type(A2, T)
    -> writeln('Both animals are of the same type.')
    ;  animal_type(A1, T1),
       animal_type(A2, T2),
       writeln('Animals are of different types.'),
       format('First animal type: ~w~n', [T1]),
       format('Second animal type: ~w~n', [T2])
    ),

    
    ( dangerous(A1), dangerous(A2)
    -> writeln('Both animals are dangerous.')
    ; \+ dangerous(A1), \+ dangerous(A2)
    -> writeln('Both animals are not dangerous.')
    ; dangerous(A1)
    -> writeln('Only the first animal is dangerous.')
    ; writeln('Only the second animal is dangerous.')
    ),

  
    ( predator(A1), predator(A2)
    -> writeln('Both animals are predators.')
    ; true
    ),

    ( herbivore(A1), herbivore(A2)
    -> writeln('Both animals are herbivores.')
    ; true
    ),

    % экосистеми
    ( ecosystem_role(A1, R), ecosystem_role(A2, R)
    -> writeln('Both animals have the same ecosystem role.')
    ; ecosystem_role(A1, R1),
      ecosystem_role(A2, R2),
      writeln('Animals have different ecosystem roles.'),
      format('First animal role: ~w~n', [R1]),
      format('Second animal role: ~w~n', [R2])
    ).
