% =========================================================
% LOGIC
% =========================================================

highest_peak(P,H) :-
    peak(P,H),
    \+ (peak(_,H2), H2 > H).

lowest_peak(P,H) :-
    peak(P,H),
    \+ (peak(_,H2), H2 < H).

average_height(Avg) :-
    findall(H, peak(_,H), L),
    sum_list(L, Sum),
    length(L, Count),
    Count > 0,
    Avg is Sum / Count.

longest_cave_karst(Karst, Name, Len) :-
    cave(Name, _, Len),
    cave_karst(Name, Karst),
    \+ (
        cave(Other, _, Len2),
        cave_karst(Other, Karst),
        Len2 > Len
    ).
