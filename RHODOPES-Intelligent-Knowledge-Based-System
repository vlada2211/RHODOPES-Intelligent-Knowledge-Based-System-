% =========================================================
% INPUT NORMALIZATION
% =========================================================

normalize_text(Input, Output) :-
    string_lower(Input, Lower),
    split_string(Lower, " _.,!?;:", " _.,!?;:", Parts),
    atomic_list_concat(Parts, '_', Output).

match_phenomenon(Input, Full) :-
    climatic_phenomenon(Full),
    normalize_text(Full, FNorm),
    sub_string(FNorm, _, _, _, Input).
